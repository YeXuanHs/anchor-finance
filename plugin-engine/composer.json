{
    "name": "anchor-finance/plugin-engine",
    "type": "project",
    "description": "AnchorFinance Plugin Engine - PHP插件引擎，兼容zjmf插件",
    "keywords": ["anchor-finance", "plugin", "zjmf", "compatible"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.3",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\ZjmfCompat\\": "app/ZjmfCompat/"
        },
        "files": [
            "zjmf_compat/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
